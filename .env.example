# Jodoo 公司开单表单的正式直接链接
VITE_JODOO_INVOICE_FORM_URL=

# 以下凭证只供 KCS 后台使用，绝对不要填写到 VITE_ 开头的变量
JODOO_API_KEY=
JODOO_APP_ID=
JODOO_TRANSACTION_ENTRY_ID=
JODOO_WEBHOOK_TOKEN=

# Google road routing (server-side only; never use VITE_ prefixes)
KCS_GOOGLE_ROUTE_OPTIMIZATION_ENABLED=0
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
# Short-lived development/emergency override only; do not use in production.
GOOGLE_ROUTE_OPTIMIZATION_ACCESS_TOKEN=
GOOGLE_ROUTES_API_KEY=
KCS_GOOGLE_ROUTE_TIMEOUT_MS=15000
KCS_GOOGLE_ROUTE_RETRY_LIMIT=2
KCS_GOOGLE_ROUTE_CACHE_TTL_SECONDS=900
KCS_GOOGLE_ROUTE_DAILY_REQUEST_LIMIT=100
KCS_GOOGLE_ROUTE_DAILY_UNIT_LIMIT=5000
KCS_GOOGLE_ROUTE_MAX_STOPS=200
KCS_GOOGLE_ROUTE_CIRCUIT_FAILURES=3
KCS_GOOGLE_ROUTE_CIRCUIT_RESET_MS=60000
KCS_ROUTE_DEFAULT_START_TIME=08:00
KCS_ROUTE_DEFAULT_END_TIME=18:00
KCS_GOOGLE_ROUTE_NON_PREFERRED_VEHICLE_PENALTY=1000
KCS_GOOGLE_ROUTE_AVOIDED_VEHICLE_PENALTY=10000
KCS_ROUTE_RULE_PROPOSAL_MIN_OVERRIDES=3
KCS_ROUTE_RULE_PROPOSAL_WINDOW_DAYS=90
KCS_ROUTE_MAX_KEEP_TOGETHER_STOPS=25

# Jodoo 表单字段 ID 或已经设置好的字段别名
JODOO_FIELD_BRANCH_ID=
JODOO_FIELD_WEIGHT=
JODOO_FIELD_INVOICE_NUMBER=
JODOO_FIELD_INVOICE_PHOTO=
JODOO_FIELD_SITE_PHOTO=
JODOO_FIELD_PAYMENT_PROOF=
JODOO_FIELD_NO_COLLECTION_STATUS=
JODOO_FIELD_NO_COLLECTION_REASON=
JODOO_FIELD_NO_COLLECTION_EVIDENCE=
